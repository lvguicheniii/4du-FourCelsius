SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * * sidu cd /opt/sidu && /usr/bin/node backup.js >> /var/log/sidu/backup.log 2>&1
20 3 * * * sidu cd /opt/sidu && timeout 300s /usr/bin/node verify-backup.js >> /var/log/sidu/backup-verify.log 2>&1
0 4 1 * * sidu cd /opt/sidu && timeout 600s /usr/bin/node restore-drill.js >> /var/log/sidu/restore-drill.log 2>&1
*/5 * * * * sidu cd /opt/sidu && timeout 60s /usr/bin/node ops-health-check.js >> /var/log/sidu/ops-health.log 2>&1
