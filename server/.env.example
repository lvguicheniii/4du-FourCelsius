NODE_ENV=development
PORT=3001
SIDU_BIND_ADDRESS=0.0.0.0
JWT_SECRET=
ADMIN_JWT_SECRET=
# Local-only bootstrap credentials. Sign in and change both values immediately.
# Production mode rejects this published password and requires a custom password
# of at least 12 characters. Never commit a populated production .env file.
ADMIN_BOOTSTRAP_USERNAME=noesis
ADMIN_BOOTSTRAP_PASSWORD=noesis
CORS_ORIGINS=http://localhost:5173
APP_UPDATE_PUBLIC_ORIGIN=http://localhost:3001
CONTENT_MODERATION_ENABLED=false
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Use `sms` in production. `fixed` is only for isolated local testing and
# must never be enabled on a public deployment.
# Local development uses the fixed code below. Set NODE_ENV=production and use
# a real verification provider before exposing this service to the internet.
ACCOUNT_VERIFICATION_MODE=fixed
ACCOUNT_FIXED_CODE=252616

# Optional Tencent Cloud verification providers. Keep empty in local mode.
TENCENTCLOUD_CAPTCHA_SECRET_ID=
TENCENTCLOUD_CAPTCHA_SECRET_KEY=
TENCENTCLOUD_CAPTCHA_APP_ID=
TENCENTCLOUD_CAPTCHA_APP_SECRET=
TENCENTCLOUD_CAPTCHA_REGION=ap-guangzhou
TENCENTCLOUD_SMS_SECRET_ID=
TENCENTCLOUD_SMS_SECRET_KEY=
TENCENTCLOUD_SMS_REGION=ap-guangzhou
TENCENTCLOUD_SMS_SDK_APP_ID=
TENCENTCLOUD_SMS_SIGN_NAME=
TENCENTCLOUD_SMS_REGISTER_TEMPLATE_ID=
TENCENTCLOUD_SMS_PASSWORD_TEMPLATE_ID=
